# Server
GRPC_PORT=50052
METRICS_PORT=2112

# Backend
BACKEND_ADDRESS=localhost:50051
BACKEND_TIMEOUT=10s
BACKEND_USE_TLS=false

# Collapser
COLLAPSER_CACHE_DURATION=100ms
COLLAPSER_CLEANUP_INTERVAL=1s
COLLAPSER_CACHE_ERRORS=false
COLLAPSER_MAX_CACHE_ENTRIES=10000
# Headers folded into the collapse key. Set this to any header the backend
# varies its response by, or two callers' requests can be collapsed together.
# COLLAPSER_KEY_HEADERS=authorization,x-tenant-id

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
